{
  "info": {
    "name": "CareConnect v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "patientId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "appointmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List patients",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/patients"
      }
    },
    {
      "name": "My patient profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/patients/me"
      }
    },
    {
      "name": "Patient details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/patients/{{patientId}}"
      }
    },
    {
      "name": "Patient contacts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/patients/{{patientId}}/contacts"
      }
    },
    {
      "name": "Add patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/patients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Synthetic Example\",\n  \"email\": \"synthetic@example.test\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"phone\": \"555-0199\",\n  \"insurance\": \"Northstar Health\",\n  \"memberId\": \"SYN1009\",\n  \"ownerSub\": \"replace-with-keycloak-subject\"\n}"
        }
      }
    },
    {
      "name": "List appointments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/appointments"
      }
    },
    {
      "name": "Book appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"providerId\": \"demo-rivera\",\n  \"providerName\": \"Dr. Elena Rivera\",\n  \"specialty\": \"Family Medicine\",\n  \"startsAt\": \"2099-01-01T10:00:00Z\",\n  \"visitType\": \"In person\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set(\"appointmentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel appointment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/appointments/{{appointmentId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CANCELLED\"\n}"
        }
      }
    },
    {
      "name": "Provider search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/providers?state=NY&name="
      }
    },
    {
      "name": "Eligibility check",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/verifications",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"memberId\": \"NS1001\",\n  \"payer\": \"Northstar Health\"\n}"
        }
      }
    },
    {
      "name": "Verification history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/verifications"
      }
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications"
      }
    },
    {
      "name": "Audit",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/audit"
      }
    }
  ]
}
